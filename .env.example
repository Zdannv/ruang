# Salin file ini menjadi .env.local, lalu isi dari Supabase Dashboard:
# Project Settings -> Data API  (URL)  dan  Project Settings -> API Keys
#
# Wajib anon/publishable key, BUKAN service_role. Kunci ini ikut terkirim ke
# browser pengunjung — service role akan membuka seluruh database ke publik.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alamat dasar yang dipakai untuk tautan di email konfirmasi.
#
# Kalau dibiarkan kosong, yang dipakai adalah alamat tempat orang menekan
# tombol daftar — dan itu masalah saat pengembangan: orang yang mendaftar dari
# http://localhost:3000 akan menerima email yang tautannya selamanya ke sana,
# padahal email itu sering dibuka beberapa menit kemudian (dev server sudah
# mati) atau dibuka di HP (localhost = HP itu sendiri).
#
# Isi dengan domain sungguhan di production. Alamat ini WAJIB juga terdaftar
# di Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs,
# kalau tidak Supabase mengabaikannya dan diam-diam memakai Site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Web push (opsional; aplikasinya jalan penuh tanpa ini) ───────────────────
#
# Tidak ada vendor yang terlibat — kunci VAPID dibuat sendiri:
#   npx web-push generate-vapid-keys
#
# Kunci publik boleh masuk bundel browser. Kunci privat TIDAK PERNAH.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Alamat kontak yang dipakai layanan push kalau pengiriman bermasalah.
VAPID_SUBJECT=mailto:halo@contoh.com

# Rahasia yang membuktikan pemanggil /api/push benar-benar Database Webhook
# Supabase. Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PUSH_RAHASIA=

# Service role key Supabase — HANYA dibaca di server, tidak pernah dikirim ke
# peramban. Jangan pernah diberi awalan NEXT_PUBLIC_: kunci ini melewati
# SELURUH RLS. Dipakai satu tempat saja, /api/push, karena pengirim push perlu
# membaca langganan milik orang lain — sesuatu yang memang tidak boleh bisa
# dilakukan pengguna mana pun.
SUPABASE_SERVICE_ROLE_KEY=
